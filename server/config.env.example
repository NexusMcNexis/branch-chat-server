# =====================================================================================================
#  BranchChat Server settings file
#  WHERE IT LIVES (the one place to look):
#    Native install (Raspberry Pi / Debian / Ubuntu):  /etc/branch-chat/config.env
#    Docker install:  the env_file next to docker-compose.yml (server/config.env, or /etc/branch-chat/config.env
#                     when install.sh set it up). Changes made on the Administrator page go to config.env in the
#                     data folder (/data/config.env inside the container); values in the env_file win over it.
#  EASIEST WAY TO CHANGE IT: sign in as the owner, open the profile menu > Administrator > Settings.
#    The page explains every setting, checks the values, keeps a dated backup of the old file in
#    config-backups/ (next to this file, or in the data folder) and restarts the server for you.
#  BY HAND: edit this file, then restart the service (sudo systemctl restart branch-chat, or docker compose restart).
#  FORMAT: KEY=VALUE, one per line, no spaces around "=". Lines starting with # are ignored. Values may be in
#    "double quotes" (then \" \\ and \$ are escapes). Nothing in this file is ever run as a command.
#  An empty or missing setting means the built-in default.
# =====================================================================================================
# BranchChat Server settings. KEY=VALUE, no spaces around "=". Lines starting with # are ignored.
# Native install: /etc/branch-chat/config.env (mode 660 root:branchchat, so the Administrator page can save it).  Docker: server/config.env.
# Every setting is optional and the built-in defaults are neutral, but a real server should always set
# at least BC_PUBLIC_URL, BC_INSTANCE_NAME, BC_OWNER and BC_MAIL_FROM.

# Public address people open in the browser (HTTPS is required for encryption, push and install).
BC_PUBLIC_URL=https://chat.example.com
# Extra host names or IPs the server answers to (comma separated). The BC_PUBLIC_URL host is always allowed.
#BC_HOSTS=branchchat.local

# Listen address. 127.0.0.1 when a tunnel or reverse proxy on the same machine is the public path.
# (Docker sets these itself.)
#BC_HOST=127.0.0.1
#BC_PORT=8766
#BC_STATE_DIR=/var/lib/branch-chat
#BC_APP_DIR=/opt/branch-chat/app

# Your group or family name, shown in page titles, the home-screen app name and invite emails.
BC_INSTANCE_NAME=The Smith Family
# Accent colour for the default theme (#rrggbb). Users can still pick their own theme.
#BC_ACCENT=#3c92ea
# Custom background picture: a .webp/.jpg/.png file name inside STATE_DIR/branding/ (or an absolute path).
#BC_BACKGROUND=background.jpg
# Optional personal credits for the About page (a JSON file: {"about_html": "<h2>About us</h2><p>...</p>",
# "icon_credit": "Icon made by ..."}). Shared pages show no personal names; leave this unset to keep it that way.
#BC_CREDITS_FILE=/etc/branch-chat/credits.json
# 1 = the About page needs sign-in (signed-out visitors go to the sign-in page). Use it on a private server with credits.
#BC_ABOUT_REQUIRES_LOGIN=1
# Contact address for a "Contact" link on the About page. Leave empty for no Contact link.
#BC_CONTACT_EMAIL=

# The owner account (gets the owner tools: user list, remove, disable, roles).
BC_OWNER=admin

# Mail for invites, sign-in codes and password resets.
BC_MAIL_FROM=BranchChat <chat@example.com>
# sendmail | smtp | log   (log = print codes to the server log instead of emailing; testing / no mail server)
BC_MAIL_MODE=smtp
BC_SMTP_HOST=smtp.example.com
BC_SMTP_PORT=587
# starttls (587) | ssl (465) | none (trusted LAN relay only)
BC_SMTP_TLS=starttls
BC_SMTP_USER=chat@example.com
# Keep the password out of this file: put it in a file only root and the service can read.
BC_SMTP_PASSWORD_FILE=/etc/branch-chat/secrets/smtp_password
# Extra sentence in invite emails (the original server mentions its sibling "encode" page).
BC_INVITE_NOTE=
# Organisation shown in the directory, on the sign-in screen and in the in-app banner (0.23.3-beta.12). Branded servers always show a small "BranchChat" credit under the name in the banner.
# With BC_ORG_ICON set (beta.13), the picture also replaces the BranchChat icon in the app's top corner and the browser tab icon (home-screen icons stay BranchChat's).
#BC_ORG_NAME=The Smith Family
#BC_ORG_ICON=/var/lib/branch-chat/branding/crest.webp     # png/jpg/webp, 64 KB max
#BC_ORG_TYPE=family          # family | church | school | club | business | community  (the directory can show a tag)

# Group chats (default on). 0 turns them off: no New group / Start a group, group creation and group invite links refused.
#BC_GROUPS=1

# 26.10.4: "What's new" email for brand-new accounts (default off). When on, each person who registers (invite or
# public sign-up) gets the single newest announcement from web/feature_emails.json about 2 minutes later.
# Existing members are never mailed by this. BC_FEATURE_EMAILS=0 turns off every feature-news email.
#BC_NEWUSER_FEATURE_EMAIL=1
#BC_NEWUSER_FEATURE_EMAIL_DELAY=120
#BC_FEATURE_EMAILS=1
#BC_FEATURE_EMAILS_FILE=/etc/branch-chat/feature_emails.json
